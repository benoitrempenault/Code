<%- include('partials/head', { title: 'Utilisateurs (admin)' }) %>
<section>
  <h1>Utilisateurs</h1>
  <% if (error) { %><p class="err"><%= error %></p><% } %>
  <% if (ok) { %><p class="flash"><%= ok %></p><% } %>

  <table class="grid">
    <thead><tr><th>Email</th><th>Nom</th><th>Rôle</th><th>État</th><th>Actions</th></tr></thead>
    <tbody>
    <% for (const u of users) { %>
      <tr class="<%= u.disabled ? 'muted' : '' %>">
        <td><%= u.email %></td>
        <td><%= u.display_name %></td>
        <td>
          <form method="post" action="/admin/users/<%= u.id %>/role" class="inline">
            <input type="hidden" name="_csrf" value="<%= _csrf %>">
            <select name="role" onchange="this.form.submit()">
              <option value="user" <%= u.role === 'user' ? 'selected' : '' %>>user</option>
              <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>admin</option>
            </select>
          </form>
        </td>
        <td>
          <% if (u.disabled) { %>
            <span class="badge danger">désactivé</span>
          <% } else if (u.locked_until && u.locked_until > Date.now()) { %>
            <span class="badge warn">verrouillé</span>
            <small>(<%= u.failed_logins %> essais)</small>
          <% } else { %>
            <span class="badge">actif</span>
          <% } %>
        </td>
        <td class="actions">
          <% if (u.disabled) { %>
            <form method="post" action="/admin/users/<%= u.id %>/enable" class="inline">
              <input type="hidden" name="_csrf" value="<%= _csrf %>">
              <button type="submit">Réactiver</button>
            </form>
          <% } else { %>
            <form method="post" action="/admin/users/<%= u.id %>/disable" class="inline" onsubmit="return confirm('Désactiver <%= u.email %> ?');">
              <input type="hidden" name="_csrf" value="<%= _csrf %>">
              <button type="submit" class="danger">Désactiver</button>
            </form>
          <% } %>
          <% if (u.locked_until && u.locked_until > Date.now()) { %>
            <form method="post" action="/admin/users/<%= u.id %>/unlock" class="inline">
              <input type="hidden" name="_csrf" value="<%= _csrf %>">
              <button type="submit">Déverrouiller</button>
            </form>
          <% } %>
          <details class="inline reset-pw">
            <summary>Réinitialiser le mot de passe</summary>
            <form method="post" action="/admin/users/<%= u.id %>/reset-password" class="reset-form">
              <input type="hidden" name="_csrf" value="<%= _csrf %>">
              <input type="password" name="password" minlength="12" maxlength="256" placeholder="Nouveau (≥12 car.)" required autocomplete="new-password">
              <button type="submit">OK</button>
            </form>
          </details>
        </td>
      </tr>
    <% } %>
    </tbody>
  </table>

  <h2>Créer un utilisateur</h2>
  <form method="post" action="/admin/users" class="card" autocomplete="off">
    <input type="hidden" name="_csrf" value="<%= _csrf %>">
    <div class="row">
      <label>Email<input type="email" name="email" required maxlength="200" autocomplete="email"></label>
      <label>Nom affiché<input name="display_name" required maxlength="200"></label>
      <label>Rôle
        <select name="role">
          <option value="user">user</option>
          <option value="admin">admin</option>
        </select>
      </label>
    </div>
    <label>Mot de passe initial (≥12 car., communiqué hors-bande)
      <input type="password" name="password" required minlength="12" maxlength="256" autocomplete="new-password">
    </label>
    <button type="submit">Créer</button>
  </form>
</section>

<style>
  td.actions { white-space: nowrap; }
  td.actions form, td.actions details { margin-right: 6px; }
  td.actions .reset-form { display: inline-flex; gap: 6px; align-items: center; margin-top: 6px; }
  .reset-pw summary { color: var(--accent); }
  .badge.warn { background: var(--warn); }
  .badge.danger { background: var(--danger); }
</style>
<%- include('partials/foot') %>
