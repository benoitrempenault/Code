<%- include('partials/head', { title: 'Modifier agence' }) %>
<section class="card">
  <h1>Modifier l'agence</h1>
  <p class="muted"><a href="/agencies?property_id=<%= p.id %>">← Retour aux agences du bien <%= p.label || ('#' + p.id) %></a></p>
  <% if (error) { %><p class="err"><%= error %></p><% } %>
  <form method="post" action="/agencies/<%= agency.id %>" autocomplete="off">
    <input type="hidden" name="_csrf" value="<%= _csrf %>">
    <div class="row">
      <label class="grow">Nom de l'agence
        <input name="name" required maxlength="200" value="<%= agency.name || '' %>">
      </label>
      <label class="check">
        <input type="checkbox" name="is_ours" value="1" <%= agency.is_ours ? 'checked' : '' %>> Notre agence
      </label>
    </div>
    <div class="row">
      <label>Honoraires (%)<input type="number" min="0" max="50" step="0.01" name="fee_pct" value="<%= agency.fee_pct || '' %>"></label>
      <label>Honoraires fixes (€)<input type="number" min="0" step="1" name="fee_fixed" value="<%= agency.fee_fixed || '' %>"></label>
      <label>Conseillers<input type="number" min="0" name="advisors" value="<%= agency.advisors || '' %>"></label>
    </div>
    <label>Sites de diffusion (séparés par virgules)
      <input name="diffusion_sites" maxlength="1000" value="<%= agency.diffusion_sites || '' %>">
    </label>
    <div class="row">
      <label>Annonces comparables<input type="number" min="0" name="comparable_listings" value="<%= agency.comparable_listings || '' %>"></label>
      <label>Prix moy. demandés (€)<input type="number" min="0" step="1" name="avg_price" value="<%= agency.avg_price || '' %>"></label>
      <label>Médiane demandés (€)<input type="number" min="0" step="1" name="median_price" value="<%= agency.median_price || '' %>"></label>
      <label>Vendus comparables<input type="number" min="0" name="sold_comparable" value="<%= agency.sold_comparable || '' %>"></label>
      <label>Prix moy. vendus (€)<input type="number" min="0" step="1" name="avg_sold_price" value="<%= agency.avg_sold_price || '' %>"></label>
    </div>
    <label>Forces<textarea name="strengths" rows="2" maxlength="4000"><%= agency.strengths || '' %></textarea></label>
    <label>Faiblesses<textarea name="weaknesses" rows="2" maxlength="4000"><%= agency.weaknesses || '' %></textarea></label>
    <label>Notes<textarea name="notes" rows="2" maxlength="4000"><%= agency.notes || '' %></textarea></label>
    <button type="submit">Enregistrer</button>
    <a href="/agencies?property_id=<%= p.id %>" class="btn" style="background:transparent;color:var(--accent);">Annuler</a>
  </form>
</section>
<%- include('partials/foot') %>
