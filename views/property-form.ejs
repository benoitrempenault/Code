<%- include('partials/head', { title: property && property.id ? 'Modifier le bien' : 'Nouveau bien' }) %>
<%
const p = property || {};
const isEdit = !!p.id;
const action = isEdit ? '/properties/' + p.id : '/properties';
const buttonLabel = isEdit ? 'Enregistrer' : 'Créer et analyser';
function v(k){ return p && p[k] != null ? p[k] : ''; }
function sel(k, val){ return v(k) === val ? ' selected' : ''; }
%>
<section class="card">
  <h1><%= isEdit ? 'Modifier le bien' : 'Nouveau bien' %></h1>
  <% if (error) { %><p class="err"><%= error %></p><% } %>
  <form method="post" action="<%= action %>" autocomplete="off">
    <input type="hidden" name="_csrf" value="<%= _csrf %>">
    <label>Libellé interne (facultatif)
      <input name="label" maxlength="200" value="<%= v('label') %>">
    </label>
    <label>Adresse
      <div class="autocomplete">
        <input id="addr" name="address" required minlength="3" maxlength="300" autocomplete="off"
               value="<%= v('address') %>">
        <ul id="addr-results" class="ac-results" hidden></ul>
      </div>
      <input type="hidden" name="city" id="addr-city" value="<%= v('city') %>">
      <input type="hidden" name="postcode" id="addr-postcode" value="<%= v('postcode') %>">
      <input type="hidden" name="insee_code" id="addr-insee" value="<%= v('insee_code') %>">
      <input type="hidden" name="lat" id="addr-lat" value="<%= v('lat') %>">
      <input type="hidden" name="lng" id="addr-lng" value="<%= v('lng') %>">
    </label>
    <div class="row">
      <label>Type
        <select name="property_type">
          <option value="maison"<%= sel('property_type','maison') %>>Maison</option>
          <option value="appartement"<%= sel('property_type','appartement') %>>Appartement</option>
          <option value="terrain"<%= sel('property_type','terrain') %>>Terrain</option>
          <option value="autre"<%= sel('property_type','autre') %>>Autre</option>
        </select>
      </label>
      <label>État du bien
        <select name="condition" required>
          <option value="">— choisir —</option>
          <option value="excellent"<%= sel('condition','excellent') %>>Excellent</option>
          <option value="tres_bon"<%= sel('condition','tres_bon') %>>Très bon</option>
          <option value="bon"<%= sel('condition','bon') %>>Bon</option>
          <option value="a_reflechir"<%= sel('condition','a_reflechir') %>>À réfléchir</option>
        </select>
      </label>
    </div>
    <div class="row">
      <label>Surface habitable (m²)<input type="number" min="0" max="50000" step="0.01" name="surface_m2" value="<%= v('surface_m2') %>"></label>
      <label>Pièces<input type="number" min="0" max="50" name="rooms" value="<%= v('rooms') %>"></label>
      <label>Chambres<input type="number" min="0" max="50" name="bedrooms" value="<%= v('bedrooms') %>"></label>
      <label>Terrain (m²)<input type="number" min="0" max="5000000" step="0.01" name="land_m2" value="<%= v('land_m2') %>"></label>
    </div>
    <label>Prix demandé (€) (facultatif)
      <input type="number" min="0" max="1000000000" step="1" name="asking_price" value="<%= v('asking_price') %>">
    </label>
    <label>Notes
      <textarea name="notes" maxlength="4000" rows="3"><%= v('notes') %></textarea>
    </label>

    <h2>Contact vendeur (privé — non partagé au client)</h2>
    <div class="row">
      <label class="grow">Nom<input name="client_name" maxlength="200" value="<%= v('client_name') %>"></label>
      <label>Téléphone<input type="tel" name="client_phone" maxlength="40" value="<%= v('client_phone') %>"></label>
      <label>Email<input type="email" name="client_email" maxlength="200" value="<%= v('client_email') %>"></label>
    </div>
    <label>Notes vendeur
      <textarea name="client_notes" maxlength="4000" rows="3"><%= v('client_notes') %></textarea>
    </label>

    <button type="submit"><%= buttonLabel %></button>
    <% if (isEdit) { %>
      <a href="/properties/<%= p.id %>" class="btn" style="background:transparent;color:var(--accent);">Annuler</a>
    <% } %>
  </form>
</section>
<script src="/static/autocomplete.js" defer></script>
<%- include('partials/foot') %>
