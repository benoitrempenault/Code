# Copy to .env and fill in. Never commit .env.
PORT=3000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_me_with_a_long_random_hex_string
# Set to 'true' in production behind HTTPS reverse proxy
TRUST_PROXY=false
# Set to 'production' in production
NODE_ENV=development
# Enable Playwright-based scrapers for Le Bon Coin / SeLoger / PAP.
# Requires `npx playwright install chromium`. Without it, only Bien'ici and
# Castorus are queried (faster, more reliable). Even when enabled, sites
# protected by DataDome / Cloudflare-bot may still block from datacenter IPs;
# residential proxies are recommended for production.
SCRAPER_BROWSER=false
# In sandboxes without system CA roots, set this to bypass TLS validation
# during scraping. NEVER set in production.
# SCRAPER_INSECURE_TLS=true
# Proxy for the headless browser. From a datacenter IP, Le Bon Coin / SeLoger /
# PAP almost always serve the DataDome challenge instead of listings; a
# residential proxy makes scraping ~80%+ reliable. Format:
#   http://user:pass@host:port  or  socks5://user:pass@host:port
# Common providers: BrightData, Smartproxy, Soax, Oxylabs.
# SCRAPER_PROXY=http://user:pass@gate.smartproxy.com:7000
